# Copy this file to ".env" and fill in your own values.
# Never upload the real ".env" file to GitHub.

PORT=5000

# Your MongoDB connection string (from MongoDB Atlas, or local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/octanelink

# Any random long text works here. This is used to "sign" JWT tokens.
JWT_SECRET=change_this_to_a_long_random_string
